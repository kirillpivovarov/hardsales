# Сервер читает переменные среды процесса или .env в рабочем каталоге.
# Для docker compose локальные значения определены в compose.yaml.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@db.example.org:5432/hwforai?sslmode=verify-full
APP_ORIGIN=https://hwforai.example.org
# Укажите точное число доверенных прокси перед NestJS.
TRUST_PROXY_HOPS=1
DEMO_MODE=false

# Строка случайных байтов, минимум 32 символа. Пример генерации см. в разделе рабочего развёртывания README.md.
OTP_SECRET=

MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hwforai <no-reply@hwforai.example.org>

# Первый запуск на пустой базе. Пароль от 12 символов. После инициализации удалите значения.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Необязательно. Оставьте пустым, чтобы отключить машинную модерацию.
MODERATION_AGENT_TOKEN=

# Абсолютный путь к сборке React. В Dockerfile уже установлен.
# SERVE_WEB_DIR=/app/web
