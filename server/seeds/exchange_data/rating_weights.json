{
  "schema_version": 1,
  "updated_at": "2026-11-25",
  "description": "Веса и пороги рейтинга участника (0-100) и объявления (0-100). Источник: demo/js/core/rating.js и spec раздел 5.",
  "participant": {
    "max_total": 100,
    "factors": [
      {
        "id": "level",
        "label_ru": "Уровень проверки",
        "max": 25,
        "points_by_level": {
          "0": 0,
          "1": 15,
          "2": 25
        }
      },
      {
        "id": "deals",
        "label_ru": "Подтверждённые сделки",
        "max": 20,
        "steps": [
          {
            "min_deals": 5,
            "points": 20
          },
          {
            "min_deals": 3,
            "points": 16
          },
          {
            "min_deals": 2,
            "points": 12
          },
          {
            "min_deals": 1,
            "points": 8
          },
          {
            "min_deals": 0,
            "points": 0
          }
        ]
      },
      {
        "id": "discipline",
        "label_ru": "Дисциплина подтверждений",
        "max": 15,
        "window_days": 30,
        "formula": "on_time_share * 15, округление до 0,1",
        "newbie_days": 7,
        "newbie_points": 10,
        "no_requests_points": 15
      },
      {
        "id": "speed",
        "label_ru": "Скорость ответа на совпадение",
        "max": 10,
        "statistic": "median_hours",
        "steps": [
          {
            "max_hours": 2,
            "points": 10
          },
          {
            "max_hours": 8,
            "points": 7
          },
          {
            "max_hours": 24,
            "points": 4
          },
          {
            "max_hours": null,
            "points": 0
          }
        ],
        "no_data_points": 0
      },
      {
        "id": "direct",
        "label_ru": "Прямой или агент",
        "max": 10,
        "direct_points": 10,
        "agent_confirmed_points": 6,
        "agent_unconfirmed_points": 2
      },
      {
        "id": "disputes",
        "label_ru": "Проигранные споры",
        "max": 10,
        "window_days": 365,
        "formula": "max(0, 10 - 5 * lost)"
      },
      {
        "id": "fees",
        "label_ru": "Открытые агентские",
        "max": 5,
        "direct_points": 5,
        "disclosed_confirmed_points": 5,
        "disclosed_unconfirmed_points": 2,
        "not_disclosed_points": 0,
        "banned_points": 0
      },
      {
        "id": "tenure",
        "label_ru": "Давность на площадке",
        "max": 5,
        "formula": "min(5, полных месяцев с created_at)"
      }
    ],
    "penalties": [
      {
        "id": "day_code_spot_check_failed",
        "points": 5,
        "window_days": 365,
        "label_ru": "Провал выборочной проверки кода дня"
      },
      {
        "id": "misrepresentation_proven",
        "points": 10,
        "window_days": 365,
        "label_ru": "Доказано несоответствие цены или количества"
      }
    ],
    "reliable_threshold": 80,
    "zero_on": [
      "BANNED"
    ],
    "deal_count_rules": {
      "repeat_same_counterparty_min_days": 90,
      "linked_accounts_excluded": true,
      "requires_both_sides_executed": true,
      "requires_admin_verified": true
    },
    "example": {
      "description": "Прямой продавец, проверен документами, 0 сделок, дисциплина 100 %, медиана ответа 3 ч, 1 полный месяц",
      "factors": {
        "level": 15,
        "deals": 0,
        "discipline": 15,
        "speed": 7,
        "direct": 10,
        "disputes": 10,
        "fees": 5,
        "tenure": 1
      },
      "total": 63
    }
  },
  "listing": {
    "max_total": 100,
    "factors": [
      {
        "id": "participant",
        "label_ru": "Рейтинг участника",
        "max": 40,
        "formula": "participant_total * 0.4, округление до 0,1"
      },
      {
        "id": "freshness",
        "label_ru": "Свежесть подтверждения",
        "max": 20,
        "confirmed_today_points": 20,
        "confirmed_within_24h_points": 12,
        "older_points": 0,
        "today": "та же календарная дата в часовом поясе площадки"
      },
      {
        "id": "price",
        "label_ru": "Реалистичность цены",
        "max": 20,
        "no_corridor_points": 10,
        "within_15pct_points": 20,
        "within_30pct_points": 10,
        "over_30pct_points": 0,
        "out_of_corridor_label_over": 0.3
      },
      {
        "id": "completeness",
        "label_ru": "Полнота объявления",
        "max": 20,
        "formula": "filled_category_attributes / attribute_keys_count * 10 + (proof_valid ? 10 : 0)"
      }
    ],
    "low_rating_threshold": 30
  },
  "corridor": {
    "market_min_listings": 5,
    "market_window_days": 14,
    "market_band": 0.1,
    "delivered_markup": 1.06,
    "source_priority": [
      "market",
      "admin"
    ]
  },
  "proof_validity_days": {
    "SELL": 14,
    "BUY": 30
  },
  "match": {
    "price_tolerance": 0.05
  }
}
